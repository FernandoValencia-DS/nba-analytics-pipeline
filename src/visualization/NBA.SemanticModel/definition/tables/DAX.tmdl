			VAR valueB =
			    IF(ISFILTERED(Team_B_ha[HA]),
			        CALCULATE(
			            [Team Avg Metric],
			            'core fct_games'[team_abbreviation] = EquipoB,
			            'core fct_games'[ha] = HA
			        ),
			        CALCULATE(
			            [Team Avg Metric],
			            'core fct_games'[team_abbreviation] = EquipoB)
