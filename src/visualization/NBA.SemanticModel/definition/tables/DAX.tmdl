	measure Conteo_Filtros_Teams =
			
			
			VAR SEASON = ISFILTERED('core fct_games'[season_num])
			VAR FILTER_DATE = ISFILTERED(calendario[Mes EN])
			VAR HA_TEAM_A = ISFILTERED(Team_A_ha[HA])
			VAR HA_TEAM_B = ISFILTERED(Team_b_ha[HA])
			VAR SEASON_TYPE = ISFILTERED('core fct_games'[season_type])
			
