	measure 'Equipo A - Record' =
			
			VAR EquipoA = SELECTEDVALUE(Team_A[Team Name])
			VAR HA = SELECTEDVALUE(Team_A_ha[HA])
			RETURN
			IF(ISFILTERED(Team_A_ha[HA]),
			    IF(HA="HOME",
			        CALCULATE(
			            MIN('core dim_standings'[home]),
			            'core dim_standings'[team_name] = EquipoA
			        ),
			        CALCULATE(
			            MIN('core dim_standings'[road]),
			            'core dim_standings'[team_name] = EquipoA
			        )),
			    CALCULATE(
			            MIN('core dim_standings'[record]),
			            'core dim_standings'[team_name] = EquipoA
			        )
			)
		displayFolder: Est_Generales_Teams
		lineageTag: 879a0258-3502-4b17-af96-3f64f2ea3441

	measure 'Victorias Equipo A' =
			
			VAR EquipoA = SELECTEDVALUE(Team_A[abbreviation])
			VAR EquipoB = SELECTEDVALUE(Team_B[abbreviation])
			VAR Wins =
			    IF(
			        ISBLANK(EquipoA) || ISBLANK(EquipoB),
			        BLANK(),
			        CALCULATE(
			            COUNTROWS('core fct_games'),
			            'core fct_games'[team_abbreviation] = EquipoA,
			            'core fct_games'[wl] = "W",
			            FILTER(
			                'core fct_games',
			                CONTAINSSTRING('core fct_games'[matchup], EquipoA)
			                && CONTAINSSTRING('core fct_games'[matchup], EquipoB)
			            )
			        )
			    )
			RETURN
			COALESCE(Wins, 0)
		formatString: 0
		displayFolder: Est_Teams
		lineageTag: 58ef686e-2d0b-4694-9641-5f2c498b67a4

	measure 'Victorias Equipo B' =
			
			VAR EquipoA = SELECTEDVALUE(Team_A[abbreviation])
			VAR EquipoB = SELECTEDVALUE(Team_B[abbreviation])
