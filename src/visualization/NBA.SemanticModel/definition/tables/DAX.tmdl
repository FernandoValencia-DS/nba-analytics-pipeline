	measure 'Player A - Percentile' =
			
			VAR PlayerA = SELECTEDVALUE('Player A'[ID])
			VAR higherBetter = [Metric Higher Is Better]
			
			VAR valueA =
			    CALCULATE(
			        [Player Avg Metric],
			        'core dim_players'[id] = PlayerA
			    )
			
			VAR dist =
			    ADDCOLUMNS(
			        VALUES('core dim_players'[id]),
			        "v", CALCULATE([Player Avg Metric])
			    )
			
			VAR n = COUNTROWS(dist)
			VAR numLess =
			    COUNTROWS(
			        FILTER(dist, [v] < valueA)
			    )
			VAR numEqual =
			    COUNTROWS(
			        FILTER(dist, [v] = valueA)
			    )
			
			VAR pctHigherBetter =
			    DIVIDE(numLess + 0.5 * numEqual, n) * 100
			
			VAR pctLowerBetter =
			    100 - pctHigherBetter
			
			RETURN
			IF(higherBetter = 1, pctHigherBetter, pctLowerBetter)
		lineageTag: 02d1ebac-30c1-4f9c-9079-564b57724f5a

