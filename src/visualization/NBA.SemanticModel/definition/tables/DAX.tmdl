			VAR dist =
			    ADDCOLUMNS(
			        VALUES('core fct_games'[team_abbreviation]),
			        "v", CALCULATE([Team Avg Metric])
			    )
			
			VAR n = COUNTROWS(dist)
			VAR numLess =
			    COUNTROWS(
			        FILTER(dist, [v] < valueB)
			    )
			VAR numEqual =
			    COUNTROWS(
			        FILTER(dist, [v] = valueB)
			    )
			
			VAR pctHigherBetter =
			    DIVIDE(numLess + 0.5 * numEqual, n) * 100
			
			VAR pctLowerBetter =
			    100 - pctHigherBetter
			
			RETURN
			IF(higherBetter = 1, pctHigherBetter, pctLowerBetter)
			
			```
		formatString: 0.00
