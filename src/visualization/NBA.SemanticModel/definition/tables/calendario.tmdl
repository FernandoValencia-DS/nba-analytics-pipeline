	column 'Dia Semana'
		lineageTag: 987e1879-a2a3-464f-9df9-d6619d3fd9f7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia Semana]

		annotation SummarizationSetBy = Automatic

	column 'Mes EN' =
			
			SWITCH (
			    'calendario'[Mes Numero],
			    1, "January",
			    2, "February",
			    3, "March",
			    4, "April",
			    5, "May",
			    6, "June",
			    7, "July",
			    8, "August",
			    9, "September",
			    10, "October",
			    11, "November",
			    12, "December"
			)
		lineageTag: 6a630553-bd70-417e-a04e-5c27950d65c9
		summarizeBy: none
		sortByColumn: 'Mes Numero'

		annotation SummarizationSetBy = Automatic

	partition calendario = calculated
		mode: import
		source =
				
				VAR FechaMin =
				    MIN ( 'core fct_games'[game_date] )
				VAR FechaMax =
				    MAX ( 'core fct_games'[game_date] )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( FechaMin, FechaMax ),
				    "Año", YEAR ( [Date] ),
				    "Mes Numero", MONTH ( [Date] ),
				    "Mes", FORMAT ([Date], "[$-en-US]MMMM" ),
				    "Año-Mes", FORMAT ( [Date], "YYYY-MM" ),
				    "Dia", DAY ( [Date] ),
				    "Dia Semana Num", WEEKDAY ( [Date], 2 ),
				    "Dia Semana", FORMAT ( [Date], "dddd" )
				)

	annotation PBI_Id = 90db77e27bef481a86c36622a08cad66

