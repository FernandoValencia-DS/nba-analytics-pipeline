	measure 'Equipo A - Avg Points' =
			
			VAR EquipoA = SELECTEDVALUE(Team_A[abbreviation])
			VAR EquipoB = SELECTEDVALUE(Team_B[abbreviation])
			VAR HA = SELECTEDVALUE(Team_A_ha[HA])
			VAR GameType = SELECTEDVALUE(games_type[GAMES], "ALL")
			
			RETURN
			IF(
			    GameType = "HEAD TO HEAD",
			
			    IF(
			        ISFILTERED(Team_A_ha[HA]),
			        CALCULATE(
			            AVERAGE('core fct_games'[pts]),
			            'core fct_games'[team_abbreviation] = EquipoA,
			            'core fct_games'[ha] = HA,
			            FILTER(
			                'core fct_games',
			                CONTAINSSTRING('core fct_games'[matchup], EquipoA) &&
			                CONTAINSSTRING('core fct_games'[matchup], EquipoB)
			            )
			        ),
			        CALCULATE(
			            AVERAGE('core fct_games'[pts]),
			            'core fct_games'[team_abbreviation] = EquipoA,
			            FILTER(
			                'core fct_games',
			                CONTAINSSTRING('core fct_games'[matchup], EquipoA) &&
			                CONTAINSSTRING('core fct_games'[matchup], EquipoB)
			            )
			        )
			    ),
			
			    IF(
			        ISFILTERED(Team_A_ha[HA]),
			        CALCULATE(
			            AVERAGE('core fct_games'[pts]),
			            'core fct_games'[team_abbreviation] = EquipoA,
			            'core fct_games'[ha] = HA
			        ),
			        CALCULATE(
			            AVERAGE('core fct_games'[pts]),
			            'core fct_games'[team_abbreviation] = EquipoA
			        )
			    )
			)
		displayFolder: Est_Teams
