	measure 'Equipo A - Mejor Jugador Zona' = ```
			
			VAR EquipoA = SELECTEDVALUE(Team_A[abbreviation])
			VAR EquipoB = SELECTEDVALUE(Team_B[abbreviation])
			VAR HA = SELECTEDVALUE(Team_A_ha[HA])
			VAR GameType = SELECTEDVALUE(games_type[GAMES], "ALL")
			VAR MinFGA = 3
			
			VAR EsHeadToHead = GameType = "HEAD TO HEAD"
			VAR HAFiltrado = ISFILTERED(Team_A_ha[HA])
			
			VAR GamesValidos =
			    FILTER(
			        'core fct_games',
			        'core fct_games'[team_abbreviation] = EquipoA
			        && (NOT HAFiltrado || 'core fct_games'[ha] = HA)
			        && (
			            NOT EsHeadToHead
			            || (CONTAINSSTRING('core fct_games'[matchup], EquipoA) && CONTAINSSTRING('core fct_games'[matchup], EquipoB))
			        )
			    )
			
			VAR TablaJugadores =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('core fct_shot_zone_gp'[player_id]),
			            "FGA_Jug", CALCULATE(SUM('core fct_shot_zone_gp'[fga])),
			            "FGM_Jug", CALCULATE(SUM('core fct_shot_zone_gp'[fgm]))
			        ),
			        GamesValidos
			    )
			
			VAR TablaFiltrada = FILTER(TablaJugadores, [FGA_Jug] >= MinFGA)
			VAR PromedioZona = DIVIDE(SUMX(TablaFiltrada, [FGM_Jug]), SUMX(TablaFiltrada, [FGA_Jug]))
			VAR C = AVERAGEX(TablaFiltrada, [FGA_Jug]) * 0.5
			
			VAR TablaAjustada =
			    ADDCOLUMNS(
			        TablaFiltrada,
			        "FGAjustado", DIVIDE([FGM_Jug] + C * PromedioZona, [FGA_Jug] + C)
			    )
			
			VAR MaxAjustado = MAXX(TablaAjustada, [FGAjustado])
			
			VAR MejorPlayerID = 
			    MINX(
			        FILTER(TablaAjustada, [FGAjustado] = MaxAjustado),
			        'core fct_shot_zone_gp'[player_id]
			    )
			
			RETURN
			    CALCULATE(
			        SELECTEDVALUE('core dim_players'[full_name]),
			        'core dim_players'[id] = MejorPlayerID
			    )
			```
		lineageTag: c4261c34-c703-4af6-90a4-dce4f9886957

