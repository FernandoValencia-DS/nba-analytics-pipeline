	measure 'Metric Higher Is Better' =
			
			VAR m = SELECTEDVALUE(Metrics[MetricKey])
			RETURN IF(m = "tov", 0, 1)
		formatString: 0
		lineageTag: 20d734f1-5a6b-4d39-9554-d39f9732b83f

	measure 'Team A - Percentile' = ```
			
			VAR EquipoA = SELECTEDVALUE(Team_A[abbreviation])
			VAR HA = SELECTEDVALUE(Team_A_ha[HA])
			VAR higherBetter = [Metric Higher Is Better]
			
			VAR valueA =
			    IF(ISFILTERED(Team_A_ha[HA]),
			        CALCULATE(
			            [Team Avg Metric],
			            'core fct_games'[team_abbreviation] = EquipoA,
			            'core fct_games'[ha] = HA
			        ),
			        CALCULATE(
			            [Team Avg Metric],
			            'core fct_games'[team_abbreviation] = EquipoA)
			    )
			
			VAR dist =
			    ADDCOLUMNS(
			        VALUES('core fct_games'[team_abbreviation]),
			        "v", CALCULATE([Team Avg Metric])
			    )
			
			VAR n = COUNTROWS(dist)
			VAR numLess =
			    COUNTROWS(
			        FILTER(dist, [v] < valueA)
			    )
			VAR numEqual =
			    COUNTROWS(
			        FILTER(dist, [v] = valueA)
			    )
			
			VAR pctHigherBetter =
			    DIVIDE(numLess + 0.5 * numEqual, n) * 100
			
			VAR pctLowerBetter =
			    100 - pctHigherBetter
			
			RETURN
			IF(higherBetter = 1, pctHigherBetter, pctLowerBetter)
			
			```
		formatString: 0.00
		displayFolder: Est_Teams
		lineageTag: eeed7041-2894-417d-8603-30aa73613b07

	measure 'Team B - Percentile' = ```
			
			VAR EquipoB = SELECTEDVALUE(Team_B[abbreviation])
			VAR HA = SELECTEDVALUE(Team_B_ha[HA])
