		formatString: 0
		displayFolder: Est_Teams
		lineageTag: b80103f5-b9a3-499f-bfd3-47f7a18a548f

	measure 'HeadToHead Resumen' = ```
			
			VAR EquipoA = SELECTEDVALUE(Team_A[abbreviation])
			VAR EquipoB = SELECTEDVALUE(Team_B[abbreviation])
			RETURN
			IF(
			    EquipoA = EquipoB, "SAME TEAM",
			        IF(ISBLANK(EquipoA) || ISBLANK(EquipoB),
			        BLANK(),
			        EquipoA & " " & [Victorias Equipo A]
			        & " - "
			        & [Victorias Equipo B] & " " & EquipoB
			        & " | GAMES: " & [Partidos Enfrentados])
			    
			)
			```
		displayFolder: Est_Generales_Teams
		lineageTag: 53d3953a-8c06-47f9-b188-a3171cbd355c

	measure 'Partidos Enfrentados' =
			
			VAR EquipoA = SELECTEDVALUE(Team_A[abbreviation])
			VAR EquipoB = SELECTEDVALUE(Team_B[abbreviation])
			RETURN
			IF(
			    ISBLANK(EquipoA) || ISBLANK(EquipoB),
			    BLANK(),
			    CALCULATE(
			        DISTINCTCOUNT('core fct_games'[game_id]),
			        FILTER(
			            'core fct_games',
			            CONTAINSSTRING('core fct_games'[matchup], EquipoA)
			            && CONTAINSSTRING('core fct_games'[matchup], EquipoB)
			        )
			    )
			)
		formatString: 0
		lineageTag: b70df073-d23b-47d5-ae50-f76143659cd7

